# ──────────────────────────────────────────────
# MikroTik SaaS — Staging Environment
# ──────────────────────────────────────────────
# Copy to .env.staging:  cp .env.staging.example .env.staging
# All values are REQUIRED in staging.

# ── Postgres ──
POSTGRES_USER=mikrotik_staging
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=mikrotik_saas

# ── Redis ──
REDIS_PASSWORD=<generate-a-strong-password>

# ── MinIO (S3-compatible storage) ──
MINIO_ROOT_USER=<generate-access-key>
MINIO_ROOT_PASSWORD=<generate-secret-key>

# ── Public URLs (used by the frontend) ──
PUBLIC_API_URL=https://api.staging.yourdomain.com
PUBLIC_WS_URL=wss://api.staging.yourdomain.com

# ── API ──
BETTER_AUTH_SECRET=<generate-a-256-bit-secret>
BETTER_AUTH_URL=https://api.staging.yourdomain.com

# ── Agent ──
AGENT_WS_SECRET=<generate-a-strong-secret>

# ── External APIs ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
ANTHROPIC_API_KEY=sk-ant-...

# ── Cloudflare ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
